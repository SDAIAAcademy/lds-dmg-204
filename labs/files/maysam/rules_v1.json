  },
  {
   "name": "iban",
   "regex": "SA[0-9]{22}",
   "level": "مقيد"
  },
  {
   "name": "email",
   "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
   "level": "مقيد"
  }
 ],
